# ==============================================================================
# Portfolio Environment Configuration (.env)
# ==============================================================================

# Application Environment ('development' or 'production')
# In production, Express serves compiled static assets from dist/ instead of Vite dev server.
NODE_ENV=production

# Server HTTP Port (defaults to 3000 if omitted)
PORT=3000

# Canonical Public URL of your deployed website (e.g. https://ashishmakwana.dev)
APP_URL=https://ashishmakwana.dev

# ------------------------------------------------------------------------------
# Admin Authentication & Security
# ------------------------------------------------------------------------------
# Email address used to log into the Admin Dashboard (/admin)
ADMIN_EMAIL=ashishmakwana435@gmail.com

# Strong production password for the Admin Dashboard.
# MUST be changed in production from the default placeholder.
ADMIN_PASSWORD=ChangeThisToAStrongProductionPassword123!

# Random secret key used to HMAC-sign bearer session tokens.
# Generate a strong 32+ character or 64-character hex string:
# e.g., run in terminal: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN_SECRET=replace_with_a_long_random_secret_hex_key_for_production

# ------------------------------------------------------------------------------
# Optional Integrations
# ------------------------------------------------------------------------------
# Google Gemini API key (optional for future AI integrations or Google AI Studio hosting)
# GEMINI_API_KEY=your_gemini_api_key_here
